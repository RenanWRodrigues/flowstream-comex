      "typeVersion": 2.8,
      "position": [
        496,
        256
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Abre a execução de um fluxo do n8n em ops.pipeline_runs (status EM_ANDAMENTO).\n-- Usada por: n8n/flows/documento_recebido.json (nó \"Abrir execução\").\n-- $1 = nome do pipeline (ex.: n8n_documento_recebido)\ninsert into ops.pipeline_runs (pipeline, status, rows_in)\nvalues (cast($1 as text), 'EM_ANDAMENTO', 1)\nreturning id, status;",
        "options": {
          "queryReplacement": "={{ [\"n8n_documento_recebido\"] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "FlowStream - Postgres (app)"
        }
      }
    },
    {
      "id": "c915b5e3-ade2-4894-b38c-df3123492634",
      "name": "Registrar documento na API",
