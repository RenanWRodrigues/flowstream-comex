      "typeVersion": 4.5,
      "position": [
        720,
        256
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/v1/documentos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ arquivo: $(\"Normalizar aviso\").item.json.arquivo }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueErrorOutput",
      "credentials": {
