          "name": "FlowStream - chave da API"
        }
      }
    },
    {
      "id": "a10f3a54-fb2f-4d4a-8f30-f13941c256b9",
      "name": "Fechar com erro",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1168,
        352
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Fecha a execução aberta por pipeline_run_inicio.sql com SUCESSO ou ERRO.\n-- Usada por: n8n/flows/documento_recebido.json (nós \"Fechar com sucesso\" e \"Fechar com erro\").\n-- $1 = id da execução | $2 = SUCESSO ou ERRO | $3 = mensagem curta (vazia em caso de sucesso;\n-- nunca CNPJ, valores ou conteúdo de documento)\nupdate ops.pipeline_runs\nset finished_at = now(),\n    status = cast($2 as text),\n    rows_out = case when cast($2 as text) = 'SUCESSO' then 1 else 0 end,\n    error = nullif(left(cast($3 as text), 500), '')\nwhere id = cast($1 as bigint)\n  and status = 'EM_ANDAMENTO'\nreturning id, status;",
        "options": {
          "queryReplacement": "={{ [$(\"Abrir execução\").item.json.id, \"ERRO\", $json.statusCode ? \"API respondeu HTTP \" + $json.statusCode + \": \" + ($json.body?.title ?? \"sem detalhe\") : \"API inacessível: \" + ($json.error?.message ?? \"erro desconhecido\")] }}"
        }
      },
      "credentials": {
        "postgres": {
          "name": "FlowStream - Postgres (app)"
        }
      }
    },
    {
