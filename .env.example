# FlowStream-Comex — copie para .env e ajuste os valores.
# Todos os valores abaixo são FICTÍCIOS. Nunca commite o arquivo .env.

# ---------------------------------------------------------------- Docker (P01)
# Porta do Postgres do Docker no computador. 5433 evita conflito com um PostgreSQL
# instalado localmente (que costuma ocupar a 5432).
POSTGRES_PORT=5433
# Superusuário: só para administração; a aplicação nunca usa este usuário.
POSTGRES_USER=flowstream_admin
POSTGRES_PASSWORD=troque-senha-admin
POSTGRES_DB=flowstream
# Usuário da aplicação (o mesmo do DATABASE_URL abaixo).
APP_DB_USER=flowstream
APP_DB_PASSWORD=troque-esta-senha
# Banco próprio do n8n, no mesmo Postgres.
N8N_DB_USER=n8n
N8N_DB_PASSWORD=troque-senha-n8n
# Chave que cifra as credenciais salvas no n8n. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria
# Versão testada com o projeto. Atualize conscientemente (veja as notas de versão do n8n).
N8N_VERSION=2.45.7

# ---------------------------------------------------------------- Aplicação
# PostgreSQL (obrigatória). Usuário, senha, porta e banco iguais aos de cima.
# Use 127.0.0.1, não localhost: no Windows, localhost tenta IPv6 primeiro e trava a conexão.
DATABASE_URL=postgresql+psycopg://flowstream:troque-esta-senha@127.0.0.1:5433/flowstream

# Ollama (LLM local, fora do Docker)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Tesseract (OCR de páginas escaneadas, P10). Deixe vazio se o tesseract.exe estiver no PATH.
# Precisa dos idiomas por e eng (tessdata).
TESSERACT_CMD=

# n8n
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/documento-recebido
# Segredo do header X-Webhook-Token: o mesmo valor vai na credencial "Header Auth" do
# webhook no n8n (docs/n8n.md). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_TOKEN=troque-por-uma-chave-aleatoria

# Telegram (opcional; deixe vazio até o P13)
TELEGRAM_BOT_TOKEN=

# Pasta monitorada para documentos de embarque
INBOX_DIR=data/inbox
# Saída dos documentos tratados (duplicados vão para PROCESSED_DIR/duplicados)
PROCESSED_DIR=data/processed

# Chave da API (header X-API-Key). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=troque-por-uma-chave-aleatoria

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
